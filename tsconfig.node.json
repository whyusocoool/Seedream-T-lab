{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "./.tsbuild-node",
    "emitDeclarationOnly": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "server/**/*.ts"]
}
